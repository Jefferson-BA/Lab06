<Window x:Class="Lab06.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Lab06.UI.ViewModels"
        xmlns:views="clr-namespace:Lab06.UI.Views"
        Title="Lab06 - Dashboard NeptunoDB" Height="700" Width="1050"
        WindowStartupLocation="CenterScreen">
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Grid Background="#F1F5F9">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Menú Lateral Sidebar -->
        <Border Grid.Column="0" Background="#0F172A" Padding="15">
            <StackPanel>
                <TextBlock Text="LAB06 NEPTUNO" Foreground="White" FontSize="18" FontWeight="Bold" Margin="0,10,0,20" HorizontalAlignment="Center"/>
                <Separator Background="#334155" Margin="0,0,0,20"/>
                <TextBlock Text="Navegue entre los módulos del sistema utilizando las pestañas superiores." Foreground="#94A3B8" TextWrapping="Wrap" FontSize="12"/>
            </StackPanel>
        </Border>

        <!-- Dashboard por Pestañas -->
        <TabControl Grid.Column="1" Margin="10" Background="White" BorderBrush="#CBD5E1">
            <TabItem Header="📦 Productos">
                <views:ProductosView DataContext="{Binding ProductosVM}"/>
            </TabItem>
            <TabItem Header="🏷️ Categorías">
                <views:CategoriasView DataContext="{Binding CategoriasVM}"/>
            </TabItem>
            <TabItem Header="🏢 Proveedores">
                <views:ProveedoresView DataContext="{Binding ProveedoresVM}"/>
            </TabItem>
            <TabItem Header="📑 Pedidos">
                <views:PedidosView DataContext="{Binding PedidosVM}"/>
            </TabItem>
            <TabItem Header="📊 Reporte Fechas">
                <views:ReportesView DataContext="{Binding ReportesVM}"/>
            </TabItem>
        </TabControl>
    </Grid>
</Window>