<UserControl x:Class="Lab06.UI.Views.ReportesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#FEF3C7" BorderBrush="#FDE68A" BorderThickness="1" Padding="10" Margin="0,0,0,15" CornerRadius="5">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Fecha Inicio:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <DatePicker SelectedDate="{Binding FechaInicio}" Width="130" Height="25" Margin="0,0,15,0"/>

                <TextBlock Text="Fecha Fin:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <DatePicker SelectedDate="{Binding FechaFin}" Width="130" Height="25" Margin="0,0,15,0"/>

                <Button Content="📊 Generar Reporte" Command="{Binding GenerarReporteCommand}" Width="150" Height="28" Background="#D97706" Foreground="White"/>
            </StackPanel>
        </Border>

        <DataGrid Grid.Row="1" ItemsSource="{Binding ReporteView}" AutoGenerateColumns="True" IsReadOnly="True" AlternatingRowBackground="#FFFBEB"/>
    </Grid>
</UserControl>