<UserControl x:Class="Lab06.UI.Views.ProveedoresView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#EEF2FF" BorderBrush="#C7D2FE" BorderThickness="1" Padding="10" Margin="0,0,0,10" CornerRadius="5">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Contacto:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <TextBox Text="{Binding FiltroContacto, UpdateSourceTrigger=PropertyChanged}" Width="140" Height="24" Margin="0,0,15,0"/>
                <TextBlock Text="Ciudad:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <TextBox Text="{Binding FiltroCiudad, UpdateSourceTrigger=PropertyChanged}" Width="140" Height="24" Margin="0,0,15,0"/>
                <Button Content="🔍 Buscar Proveedores" Command="{Binding BuscarCommand}" Width="160" Height="26" Background="#4F46E5" Foreground="White"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="5">
                <TextBlock Text="Compañía:"/>
                <TextBox Text="{Binding CompaniaNombre, UpdateSourceTrigger=PropertyChanged}" Height="24"/>
                <TextBlock Text="Ciudad:" Margin="0,5,0,0"/>
                <TextBox Text="{Binding Ciudad, UpdateSourceTrigger=PropertyChanged}" Height="24"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="5">
                <TextBlock Text="Contacto:"/>
                <TextBox Text="{Binding NombreContacto, UpdateSourceTrigger=PropertyChanged}" Height="24"/>
                <TextBlock Text="Teléfono:" Margin="0,5,0,0"/>
                <TextBox Text="{Binding Telefono, UpdateSourceTrigger=PropertyChanged}" Height="24"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Margin="5">
                <TextBlock Text="Cargo Contacto:"/>
                <TextBox Text="{Binding CargoContacto, UpdateSourceTrigger=PropertyChanged}" Height="24"/>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10" HorizontalAlignment="Right">
            <Button Content="Limpiar" Command="{Binding LimpiarCommand}" Width="80" Height="28" Margin="5" Background="#64748B" Foreground="White"/>
            <Button Content="Guardar" Command="{Binding GuardarCommand}" Width="110" Height="28" Margin="5" Background="#2563EB" Foreground="White"/>
            <Button Content="Baja Lógica" Command="{Binding EliminarCommand}" Width="110" Height="28" Margin="5" Background="#DC2626" Foreground="White"/>
        </StackPanel>

        <DataGrid Grid.Row="3" ItemsSource="{Binding ProveedoresView}" SelectedItem="{Binding SelectedProveedor}" AutoGenerateColumns="True" IsReadOnly="True" AlternatingRowBackground="#F1F5F9"/>
    </Grid>
</UserControl>